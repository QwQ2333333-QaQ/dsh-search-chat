{
  "name": "dsh-search-chat",
  "version": "0.4.1",
  "description": "DeepSeek Harness 右侧栏会话搜索：跨工作区字面检索，支持以日期为中心向上下翻看聊天记录、搜索历史与本地结果缓存，可自定义关键词高亮与面板背景。",
  "type": "module",
  "private": false,
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwQ2333333-QaQ/dsh-search-chat.git"
  },
  "homepage": "https://github.com/QwQ2333333-QaQ/dsh-search-chat#readme",
  "bugs": {
    "url": "https://github.com/QwQ2333333-QaQ/dsh-search-chat/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-search",
    "search",
    "right-sidebar"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "validate": "node scripts/validate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
