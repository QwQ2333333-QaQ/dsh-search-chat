{
  "name": "dsh-search-chat",
  "version": "0.1.0",
  "description": "DeepSeek Harness 右侧栏会话搜索：跨全部工作区按字符匹配查找聊天记录，点击结果跳到对应会话的消息附近。",
  "type": "module",
  "private": false,
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-search",
    "search",
    "right-sidebar"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "validate": "node scripts/validate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
